<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cloud Hub | Gestión de Servicios</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen text-slate-800">
  <div class="max-w-5xl mx-auto px-4 py-8">
    <header class="text-center mb-10">
      <h1 class="text-4xl font-extrabold text-blue-600 tracking-tight">☁️ Cloud Hub</h1>
      <p class="text-slate-500 mt-2">Gestiona y accede a tus plataformas en la nube</p>
    </header>

    <!-- Formulario dinámico (Agregar / Editar) -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 mb-8">
      <h2 class="text-xl font-semibold mb-4">
        <%= editMode ? '✏️ Editar Servicio' : '➕ Agregar Nuevo Servicio' %>
      </h2>
      <form action="<%= editMode ? '/update/' + currentEdit.id : '/add' %>" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <input type="text" name="name" placeholder="Nombre (ej. GitHub)" required value="<%= editMode && currentEdit ? currentEdit.name : '' %>" class="border border-slate-300 p-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
        <input type="url" name="url" placeholder="https://..." required value="<%= editMode && currentEdit ? currentEdit.url : '' %>" class="border border-slate-300 p-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
        <input type="text" name="description" placeholder="Descripción breve" value="<%= editMode && currentEdit ? currentEdit.description : '' %>" class="border border-slate-300 p-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400">

        <div class="md:col-span-3 flex gap-3 mt-2">
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition">
            <%= editMode ? '💾 Guardar Cambios' : '✅ Agregar Servicio' %>
          </button>
          <% if (editMode) { %>
            <a href="/" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-6 py-2 rounded-lg transition">Cancelar</a>
          <% } %>
        </div>
      </form>
    </div>

    <!-- Grid de tarjetas -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
      <% if (services.length === 0) { %>
        <p class="text-center text-slate-400 col-span-full py-10">No hay servicios registrados. ¡Agrega el primero!</p>
      <% } %>
      <% services.forEach(s => { %>
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 hover:shadow-md transition group">
          <div class="flex justify-between items-start mb-2">
            <h3 class="font-bold text-lg text-slate-800 truncate pr-2"><%= s.name %></h3>
            <div class="flex gap-2 opacity-70 group-hover:opacity-100 transition">
              <!-- Botón Editar -->
              <a href="/edit/<%= s.id %>" class="p-1.5 rounded-full hover:bg-blue-50 text-blue-600 hover:text-blue-800 transition" title="Editar">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                </svg>
              </a>
              <!-- Botón Eliminar -->
              <form action="/delete/<%= s.id %>" method="POST" onsubmit="return confirm('¿Eliminar este servicio permanentemente?');">
                <button type="submit" class="p-1.5 rounded-full hover:bg-red-50 text-red-500 hover:text-red-700 transition" title="Eliminar">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                  </svg>
                </button>
              </form>
            </div>
          </div>
          <p class="text-slate-500 text-sm mb-4 line-clamp-2"><%= s.description %></p>
          <a href="<%= s.url %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium text-sm">
            🔗 Abrir plataforma
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      <% }) %>
    </div>

    <!-- Footer con tus datos -->
    <footer class="border-t border-slate-200 pt-8 pb-6 text-center bg-white">
      <div class="mb-6">
        <p class="text-slate-500 text-sm mb-3">🌐 Integraciones con servicios externos:</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="bg-gray-800 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition text-sm">GitHub</a>
          <a href="https://www.figma.com" target="_blank" rel="noopener noreferrer" class="bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-500 transition text-sm">Figma</a>
          <a href="https://notion.so" target="_blank" rel="noopener noreferrer" class="bg-white text-gray-800 px-4 py-2 rounded-lg border hover:bg-gray-50 transition text-sm">Notion</a>
          <a href="https://vercel.com" target="_blank" rel="noopener noreferrer" class="bg-black text-white px-4 py-2 rounded-lg hover:bg-gray-800 transition text-sm">Vercel</a>
        </div>
      </div>
      <div class="bg-slate-50 rounded-xl p-5 max-w-2xl mx-auto border border-slate-200">
        <h3 class="font-bold text-slate-700 mb-3">👨‍💻 Desarrollado por:</h3>
        <div class="space-y-1.5 text-sm">
          <p class="text-slate-800"><span class="font-semibold">Nombre:</span> Aldo Guerrero Ortega</p>
          <p class="text-slate-800"><span class="font-semibold">ID:</span> 222353187</p>
          <p class="text-slate-800"><span class="font-semibold">Materia:</span> Conceptualización de servicios en la nube</p>
          <p class="text-slate-800"><span class="font-semibold">Proyecto:</span> PI. Aplicación web dinámica en un servicio de la nube</p>
        </div>
      </div>
      <p class="text-slate-400 text-xs mt-6">&copy; <%= new Date().getFullYear() %> • Cloud Hub • Render + PostgreSQL</p>
    </footer>
  </div>
</body>
</html>
